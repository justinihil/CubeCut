<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- needed so Find solves can keep running (with a progress notification) while you use other apps.
         The kind of work is "media processing" on Android 15 and newer, "data sync" before that (see AnalysisService.kt). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        No backups: CubeCut keeps everything on the phone. allowBackup="false" stops the Google backup; on Android 12 and newer
        the rules file also stops phone-to-phone transfer, which allowBackup alone doesn't. (A restored list would only point at
        videos on the old phone anyway.) Possible later: allow it and add a way to reconnect many videos at once.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CubeCut">
        <!--
            screenOrientation: CubeCut always stays upright, even with auto-rotate on (the screens are made for portrait).
            configChanges: when the phone switches to dark mode, the font size or display size changes, or the app goes into split
            screen, CubeCut redraws itself instead of being restarted by Android. A restart would close the editor and stop a
            running Find solves or export. (On tablets and foldables Android may ignore the portrait lock; this line still keeps
            everything when it rotates there.)
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CubeCut"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|keyboard|keyboardHidden|navigation|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".AnalysisService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />
    </application>

</manifest>