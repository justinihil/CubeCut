<?xml version="1.0" encoding="utf-8"?>
<!--
    CubeCut keeps everything on the phone: nothing goes into the Google backup (cloud-backup) and nothing is copied when
    moving to a new phone (device-transfer). Used on Android 12 and newer; see the note in AndroidManifest.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
